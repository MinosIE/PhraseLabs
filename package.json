{
  "name": "phraselabs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite-ssg build && node scripts/postbuild.mjs",
    "preview": "vite preview",
