    "vue": "^3.5.44",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@unhead/vue": "^2.1.17",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "workbox-window": "^7.4.1"
  }
}
